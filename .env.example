# Server-only credentials for the CBC Portfolio hosted Supabase project.
# Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Server-only Upstash rate-limit configuration.
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
RATE_LIMIT_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Exact server-side origins allowed to submit enquiries.
# Replace these placeholders with your real production, preview, or local origins.
# Separate each exact origin with a comma; do not use paths, wildcards, or NEXT_PUBLIC_.
ENQUIRY_ALLOWED_ORIGINS=https://replace-with-production-origin.example,https://replace-with-preview-origin.example
# For local development, use only: ENQUIRY_ALLOWED_ORIGINS=http://localhost:3000

# Existing browser-based Formspree form endpoint. This is public configuration,
# not a secret; it will be removed when the form is moved to the server API.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
